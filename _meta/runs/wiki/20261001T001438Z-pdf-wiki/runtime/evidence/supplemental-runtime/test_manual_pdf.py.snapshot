    ('scope_missing_user_confirmation', lambda f: f.scope.update(publication_confirmation=''), True),
    ('scope_model_fallback_integer', lambda f: f.scope.update(model=dict(M.MODEL_PIN,fallback_allowed=0)), True),
    ('execution_wrong_route', lambda f: f.approval.update(approved_route=dict(M.ROUTE,api_mode='responses')), True),
    ('execution_wrong_model', lambda f: f.approval.update(model='other'), True),
    ('execution_wrong_effort', lambda f: f.approval.update(reasoning_effort='high'), True),
    ('execution_wrong_versions', lambda f: f.approval.update(version_ids=VIDS[:1]), True),
    ('execution_no_freeze', lambda f: f.approval.update(publication_edit_freeze_confirmed=False), True),
    ('execution_wrong_retries', lambda f: f.approval.update(max_attempts_per_item=3), True),
    ('scope_drift', lambda f: f.write(RUN+'/scope-approval.json', encoded(dict(f.scope,recorded_at='changed'))), False),
    ('policy_drift', lambda f: f.write('_meta/automation.json', encoded(dict(f.policy,enabled=True))), False),
    ('policy_v2', lambda f: f.policy.update(policy_revision='pkm-html-knowledge/v2'), True),
    ('policy_enabled', lambda f: f.policy.update(enabled=True), True),
    ('policy_p3', lambda f: f.policy['phase_authorizations'].update(P3=True), True),
    ('policy_p6', lambda f: f.policy['phase_authorizations'].update(P6=True), True),
    ('policy_registration', lambda f: f.policy.update(registration_authorized=True), True),
    ('policy_job_active', lambda f: f.policy['jobs']['daily_compile'].update(enabled=True), True),
    ('policy_registered', lambda f: f.policy['jobs']['research_review'].update(cron_id='bad'), True),
    ('policy_fallback', lambda f: f.policy.update(model=dict(M.MODEL_PIN,fallback_allowed=True)), True),
    ('policy_fallback_integer', lambda f: f.policy.update(model=dict(M.MODEL_PIN,fallback_allowed=0)), True),
    ('policy_pdf_binary', lambda f: f.policy.update(pdf_reading=dict(M.PDF_READING,pdf_binary_transfer=True)), True),
    ('policy_ocr', lambda f: f.policy.update(pdf_reading=dict(M.PDF_READING,ocr=True)), True),
    ('policy_reading_integer', lambda f: f.policy.update(pdf_reading=dict(M.PDF_READING,ocr=0)), True),
    ('policy_transfer_off', lambda f: f.policy['transfer'].update(pdf_content=False), True),
    ('policy_images', lambda f: f.policy['transfer'].update(images=True), True),
    ('policy_wrong_environment', lambda f: f.policy.update(pdf_reading=dict(M.PDF_READING,environment='/global')), True),
    ('policy_persist', lambda f: f.policy.update(pdf_reading=dict(M.PDF_READING,persistent_extraction=True)), True),
    ('state_safety', lambda f: f.state.update(safety_block=True), True),
    ('state_unresolved', lambda f: f.state.update(transactions=[{'status':'prepared'}]), True),
    ('state_blocked', lambda f: f.state['items'][0].update(status='blocked_policy'), True),
    ('state_failures', lambda f: f.state['items'][0].update(failure_count=3), True),
    ('source_html_input', lambda f: f.approval['sources'][VIDS[0]].update(source_path='raw/other/source.html'), True),
    ('source_traversal', lambda f: f.approval['sources'][VIDS[0]].update(source_path='../secret.pdf'), True),
    ('source_unapproved', lambda f: f.approval['sources'].update({'other':f.approval['sources'][VIDS[0]]}), True),
    ('source_hash_bad_format', lambda f: f.approval['sources'][VIDS[0]].update(source_sha256='x'*64), True),
    ('source_metadata_drift', lambda f: f.write(f.approval['sources'][VIDS[0]]['metadata_path'], b'{}'), False),
    ('source_symlink', lambda f: ((f.root/f.approval['sources'][VIDS[0]]['source_path']).unlink(),
        (f.root/f.approval['sources'][VIDS[0]]['source_path']).symlink_to('source.json')), True),
    ('wiki_raw', lambda f: f.approval.update(wiki_inputs=[{'path':'raw/paper.md','sha256':'0'*64}]), True),
    ('wiki_env', lambda f: f.approval.update(wiki_inputs=[{'path':'.env','sha256':'0'*64}]), True),
    ('wiki_traversal', lambda f: f.approval.update(wiki_inputs=[{'path':'concepts/../secret.md','sha256':'0'*64}]), True),
    ('wiki_drift', lambda f: f.write('concepts/synthetic.md',b'changed'), False),
    ('prompt_drift', lambda f: f.write(M.PROMPT,b'changed'), False),
    ('instructions_drift', lambda f: f.write(f.approval['instructions_path'],b'changed'), False),
    ('documents_drift', lambda f: f.write('AGENTS.md',b'changed'), False),
]:
    setattr(Tests, 'test_gate_'+name, refusal_case(mutate, sync))


def document_case(mutate):
    def test(self):
        out = self.compile_fake()
        doc = self.document()
        mutate(doc)
        out['text'] = json.dumps(doc, ensure_ascii=False)
        report = M.verify_result(root=self.f.root, run=RUN, vid=VIDS[0], result=out, test_config=self.f.config)
        self.assertFalse(report['passed'])
    return test


for name, mutate in [
    ('duplicate_claim', lambda d: d['claims'].append(copy.deepcopy(d['claims'][0]))),
    ('wrong_page', lambda d: d['claims'][0].update(anchor='page=2')),
    ('page_zero', lambda d: d['claims'][0].update(anchor='page=0')),
    ('page_fraction', lambda d: d['claims'][0].update(anchor='page=1.0')),
    ('page_out_of_range', lambda d: d['claims'][0].update(anchor='page=99')),
    ('page_integer', lambda d: d['claims'][0].update(anchor=1)),
    ('wrong_quote_page', lambda d: d['claims'][0].update(quote='Beta evidence two.')),
    ('empty_quote', lambda d: d['claims'][0].update(quote='  ')),
    ('wrong_title', lambda d: d.update(title='Other')),
    ('wrong_id', lambda d: d.update(version_id=VIDS[1])),
    ('frontmatter', lambda d: d.update(markdown_body='---\ntitle: x\n---\n'+d['markdown_body'])),
    ('bom_frontmatter', lambda d: d.update(markdown_body='\ufeff---\ntitle: x\n---\n'+d['markdown_body'])),
    ('body_english', lambda d: d.update(markdown_body='English only')),
    ('missing_unread', lambda d: d.update(unread_scope=['unclear'])),
    ('partial_claiming_complete', lambda d: d.update(read_scope=['page=1'])),
    ('duplicate_read_scope', lambda d: d.update(read_scope=['page=1','page=2','page=2'])),
    ('invalid_bool', lambda d: d.update(main_text_complete=1)),
    ('extra_field', lambda d: d.update(frontmatter={})),
    ('missing_conditions', lambda d: d['claims'][0].pop('conditions')),
    ('hidden_citation', lambda d: d.update(markdown_body='```\n'+d['markdown_body']+'\n```')),
    ('hidden_html', lambda d: d.update(markdown_body='<div hidden>'+d['markdown_body']+'</div>')),
    ('escaped_citation', lambda d: d.update(markdown_body=d['markdown_body'].replace('^[','\\^['))),
    ('uncited_repeat', lambda d: d.update(markdown_body=d['markdown_body']+'\nC01 별도 주장.')),
    ('claim_different_line', lambda d: d.update(markdown_body=d['markdown_body'].replace(' ^[','\n^['))),
    ('wrong_canonical_source', lambda d: d.update(markdown_body=d['markdown_body'].replace(VIDS[0],VIDS[1]))),
    ('unapproved_wikilink', lambda d: d.update(markdown_body=d['markdown_body']+'\n[[concepts/missing]]')),
    ('wiki_bad_fragment', lambda d: d.update(markdown_body=d['markdown_body']+'\n[[concepts/synthetic#absent]]')),
    ('future_bad_fragment', lambda d: d.update(markdown_body=d['markdown_body']+'\n[[entities/arxiv-'+VIDS[1]+'#absent]]')),
    ('local_secret_link', lambda d: d.update(markdown_body=d['markdown_body']+'\n[secret](../.env)')),
    ('external_link', lambda d: d.update(markdown_body=d['markdown_body']+'\n[web](https://example.com)')),
    ('image_link', lambda d: d.update(markdown_body=d['markdown_body']+'\n![image](image.png)')),
    ('reference_link', lambda d: d.update(markdown_body=d['markdown_body']+'\n[secret][hidden]\n[hidden]: ../.env')),
]:
    setattr(Tests, 'test_document_'+name, document_case(mutate))


